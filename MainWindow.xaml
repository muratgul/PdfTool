                            <Border Grid.Column="1" Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_54}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextLight}" Margin="0,0,0,16"/>
                                    
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_126}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbCompressLevel" SelectedIndex="2" Margin="0,0,0,12">
                                        <ComboBoxItem Content="{DynamicResource Str_65}"/>
                                        <ComboBoxItem Content="{DynamicResource Str_151}"/>
                                        <ComboBoxItem Content="{DynamicResource Str_114}"/>
                                    </ComboBox>

                                    <CheckBox Foreground="{DynamicResource TextLight}" x:Name="ChkCompressImages" Content="{DynamicResource Str_129}" IsChecked="True" Margin="0,0,0,8"/>
                                    <CheckBox Foreground="{DynamicResource TextLight}" x:Name="ChkCompressStreams" Content="{DynamicResource Str_85}" IsChecked="True" Margin="0,0,0,24"/>

                                    <Button x:Name="BtnCompressAction" Content="{DynamicResource Str_24}" Style="{StaticResource ModernButtonStyle}" Click="BtnCompressAction_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Protect Tab -->
                <TabItem Header="{DynamicResource Str_39}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Str_6}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLight}"/>
                            <TextBlock Text="{DynamicResource Str_146}" FontSize="13" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,16,0" Padding="20" AllowDrop="True" DragOver="SinglePdfDragOver" Drop="ProtectDrop">
                                <controls:FilePreviewControl x:Name="PreviewProtectFile" FileSelectRequested="BtnSelectProtectFile_Click"/>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Padding="20">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_152}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbProtectAction" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="{DynamicResource Str_119}"/>
                                        <ComboBoxItem Content="{DynamicResource Str_161}"/>
                                    </ComboBox>
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_27}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtProtectPassword" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,24"/>
                                    <Button x:Name="BtnProtectAction" Content="{DynamicResource Str_43}" Style="{StaticResource ModernButtonStyle}" Click="BtnProtectAction_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Page Number Tab -->
                <TabItem Header="{DynamicResource Str_87}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Str_84}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLight}"/>
                            <TextBlock Text="{DynamicResource Str_68}" FontSize="13" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,16,0" Padding="20" AllowDrop="True" DragOver="SinglePdfDragOver" Drop="PageNumberDrop">
                                <Grid>
                                    <controls:FilePreviewControl x:Name="PreviewPageNumberFile" FileSelectRequested="BtnSelectPageNumberFile_Click"/>
                                    <Grid x:Name="PageNumberPreviewContainer" Visibility="Collapsed" ClipToBounds="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- PDF Page Preview -->
                                        <Border Grid.Row="0" Background="#E5E7EB" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid x:Name="PageNumberPreviewGrid">
                                                    <Border Background="White">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="0"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Image x:Name="ImgPageNumberPreview" Stretch="None"/>
                                                    <TextBlock x:Name="TxtPageNumberLive" Text="Sayfa 1 / 1" Foreground="Black" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20"
                                                               FontSize="10" FontFamily="Arial"/>
                                                </Grid>
                                            </Viewbox>
                                        </Border>

                                        <!-- Info and Navigation stacked below -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                            <!-- Page Navigation Controls -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <Button x:Name="BtnPrevPreviewPage" Content="◀" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,10,0" Click="BtnPrevPreviewPage_Click"/>
                                                <TextBlock x:Name="TxtPreviewPageInfo" Text="{DynamicResource Str_154}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextLight}"/>
                                                <Button x:Name="BtnNextPreviewPage" Content="▶" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="10,0,0,0" Click="BtnNextPreviewPage_Click"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TxtPageNumberFileName" Text="{DynamicResource Str_93}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtPageNumberFilePages" Text="{DynamicResource Str_3}" Foreground="{DynamicResource TextGray}" FontSize="11" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                            <Button Content="{DynamicResource Str_40}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="BtnSelectPageNumberFile_Click" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Padding="20">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_90}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtPageNumberFormat" Style="{StaticResource ModernTextBoxStyle}" Text="Sayfa {0} / {1}" Margin="0,0,0,12" TextChanged="PageNumberSetting_Changed"/>
                                    
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_62}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbPageNumberFont" Margin="0,0,0,12" SelectionChanged="PageNumberSetting_Changed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" ToolTip="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_64}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,12" Width="120" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosTL" Grid.Row="0" Grid.Column="0" Content="↖" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosTC" Grid.Row="0" Grid.Column="1" Content="↑" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosTR" Grid.Row="0" Grid.Column="2" Content="↗" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosBL" Grid.Row="1" Grid.Column="0" Content="↙" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosBC" Grid.Row="1" Grid.Column="1" Content="↓" IsChecked="True" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="PosBR" Grid.Row="1" Grid.Column="2" Content="↘" Style="{StaticResource PositionToggleStyle}" Checked="PageNumberSetting_Changed"/>
                                    </Grid>
                                    
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_127}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                        <Slider x:Name="SldPageNumberMarginX" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,6" ValueChanged="PageNumberSetting_Changed"/>
                                        <TextBlock Foreground="{DynamicResource TextLight}" Grid.Row="0" Grid.Column="2" Text="{Binding ElementName=SldPageNumberMarginX, Path=Value}" VerticalAlignment="Center" Width="20" TextAlignment="Right" Margin="0,0,0,6"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SldPageNumberMarginY" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="PageNumberSetting_Changed"/>
                                        <TextBlock Foreground="{DynamicResource TextLight}" Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=SldPageNumberMarginY, Path=Value}" VerticalAlignment="Center" Width="20" TextAlignment="Right"/>
                                    </Grid>
                                    
                                    <TextBlock Foreground="{DynamicResource TextLight}" Text="{DynamicResource Str_50}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SldPageNumberSize" Minimum="6" Maximum="48" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="PageNumberSetting_Changed"/>
                                        <TextBlock Foreground="{DynamicResource TextLight}" Grid.Column="1" Text="{Binding ElementName=SldPageNumberSize, Path=Value}" VerticalAlignment="Center" Width="20" TextAlignment="Right"/>
                                    </Grid>

                                    <Button x:Name="BtnPageNumberAction" Content="{DynamicResource Str_142}" Style="{StaticResource ModernButtonStyle}" Click="BtnPageNumberAction_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Extract Text Tab -->
                <TabItem Header="{DynamicResource Str_60}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Str_131}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLight}"/>
                            <TextBlock Text="{DynamicResource Str_144}" FontSize="13" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,16,0" Padding="20" AllowDrop="True" DragOver="SinglePdfDragOver" Drop="ExtractTextDrop">
                                <controls:FilePreviewControl x:Name="PreviewExtractTextFile" FileSelectRequested="BtnSelectExtractTextFile_Click"/>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Padding="20">
                                <StackPanel>
                                    <Button x:Name="BtnExtractTextAction" Content="{DynamicResource Str_91}" Style="{StaticResource ModernButtonStyle}" Click="BtnExtractTextAction_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Extract Image Tab -->
                <TabItem Header="{DynamicResource Str_9}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Str_92}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLight}"/>
                            <TextBlock Text="{DynamicResource Str_18}" FontSize="13" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,16,0" Padding="20" AllowDrop="True" DragOver="SinglePdfDragOver" Drop="ExtractImageDrop">
                                <controls:FilePreviewControl x:Name="PreviewExtractImageFile" FileSelectRequested="BtnSelectExtractImageFile_Click"/>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BackgroundCard}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Padding="20">
                                <StackPanel>
                                    <RadioButton Foreground="{DynamicResource TextLight}" x:Name="RbExtractImagesAll" Content="{DynamicResource Str_109}" IsChecked="True" Margin="0,0,0,8"/>
                                    <RadioButton Foreground="{DynamicResource TextLight}" x:Name="RbExtractImagesUnique" Content="{DynamicResource Str_153}" Margin="0,0,0,16"/>
                                    <Button x:Name="BtnExtractImageAction" Content="{DynamicResource Str_105}" Style="{StaticResource ModernButtonStyle}" Click="BtnExtractImageAction_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Global Success / Error Toast Message Bar -->
            <Border x:Name="BorderToast" Grid.Row="1" Visibility="Collapsed" CornerRadius="6" Padding="15,10" Margin="0,16,0,0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="ToastIcon" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                          Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtToastMessage" Grid.Column="1" Text="{DynamicResource Str_44}" Foreground="White" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCloseToast_Click" VerticalAlignment="Center" Padding="5,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
