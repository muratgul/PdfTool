<Window x:Class="PdfTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdfTool"
        xmlns:controls="clr-namespace:PdfTool.Controls"
        mc:Ignorable="d"
        Title="{DynamicResource Str_118}" 
        Height="800" Width="1000"
        MinHeight="850" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundDark}"
        Foreground="{DynamicResource TextLight}"
        Icon="pack://application:,,,/icon.ico"
        FontFamily="Segoe UI, Segoe UI Semibold, Roboto, Helvetica, Arial">

    <Window.Resources>
        <!-- Rounded Buttons Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BackgroundCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{DynamicResource BorderDark}"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Action Button Style (e.g. Remove, Clear) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
                        <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextLight}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for Grid Position -->
        <Style x:Key="PositionToggleStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundCard}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Margin="2">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextLight}" FontSize="18" FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SidebarMenu"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="{DynamicResource TextGray}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <Grid Margin="15,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="iconPresenter" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Foreground="{DynamicResource TextLight}" Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundActive}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Styling -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource BackgroundCard}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- App Header / Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V7h2v2zm6 12H12v-2h4v2zm0-4H12v-2h4v2zm0-4H12V7h4v2z" 
                          Fill="{DynamicResource PrimaryBrush}" Width="26" Height="26" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Str_167}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextLight}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavHome" Content="{DynamicResource Str_112}" IsChecked="true" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        
                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavMerge" Content="{DynamicResource Str_100}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M9 2v14h8V2H9zm6 12H11V4h4v10zm-8 4v2h12v-2H7zm-4 4v2h16v-2H3z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavRotate" Content="{DynamicResource Str_78}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M12 2A10 10 0 1 0 22 12A10 10 0 0 0 12 2M12 20A8 8 0 1 1 20 12A8 8 0 0 1 12 20M12 6V12L16 14.5L15 16L10 13V6H12Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavDelete" Content="{DynamicResource Str_157}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavSplit" Content="{DynamicResource Str_61}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 2h2v5h-2V5zm-4 0h2v5H9V5zM5 5h2v5H5V5zm14 14H5v-7h14v7z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavWatermark" Content="{DynamicResource Str_2}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavToImage" Content="{DynamicResource Str_53}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0-2-.9-2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavToPdf" Content="{DynamicResource Str_66}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavCompress" Content="{DynamicResource Str_28}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-4v2h4v-2zm4-4h-8v2h8V8z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavProtect" Content="{DynamicResource Str_67}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavPageNumber" Content="{DynamicResource Str_120}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-4-4h3v-4h2v4h3l-4 4zm4-9V6l-4 4h-3v4h-2V6L5 8V6l4-4h2v4h3l4-4v2z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavExtractText" Content="{DynamicResource Str_88}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>

                        <RadioButton Foreground="{DynamicResource TextLight}" x:Name="BtnNavExtractImage" Content="{DynamicResource Str_47}" Style="{StaticResource SidebarButtonStyle}" Checked="BtnNav_Checked">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer / Info -->
                <Grid Grid.Row="2" Margin="15,0">
                    <TextBlock x:Name="TxtVersion" Text="{DynamicResource Str_167}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="BtnToggleLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Dil / Language" Margin="0,0,10,0">
                            <TextBlock Text="🌐" FontSize="18" Foreground="{DynamicResource TextGray}"/>
                        </Button>
                        <Button Click="BtnToggleTheme_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{DynamicResource Str_33}">
                            <Path Data="M12,2C17.52,2 22,6.48 22,12C22,17.52 17.52,22 12,22C6.48,22 2,17.52 2,12C2,6.48 6.48,2 12,2M12,4V20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4Z" Fill="{DynamicResource TextGray}" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Content Panels (TabControl with hidden headers) -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> <!-- Global Toast/Notification Bar -->
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabControl" BorderThickness="0" Background="Transparent" Padding="0" Grid.Row="0" Foreground="{DynamicResource TextLight}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ================= 1. HOME TAB ================= -->
                <TabItem Header="{DynamicResource Str_77}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <TextBlock Text="{DynamicResource Str_99}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextLight}"/>
                            <TextBlock Text="{DynamicResource Str_163}" FontSize="14" Foreground="{DynamicResource TextGray}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Dashboard Quick Cards -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                            <!-- Card 1: Merge -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6" Padding="12" Click="CardMerge_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M9 2v14h8V2H9zm6 12H11V4h4v10zm-8 4v2h12v-2H7zm-4 4v2h16v-2H3z" Fill="{DynamicResource PrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Str_100}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_16}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 2: Rotate -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6" Padding="12" Click="CardRotate_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M12 2A10 10 0 1 0 22 12A10 10 0 0 0 12 2M12 20A8 8 0 1 1 20 12A8 8 0 0 1 12 20M12 6V12L16 14.5L15 16L10 13V6H12Z" Fill="{DynamicResource PrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Str_78}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_132}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 3: Delete -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6" Padding="12" Click="CardDelete_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{DynamicResource PrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Str_157}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_125}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 4: Split -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6" Padding="12" Click="CardSplit_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 2h2v5h-2V5zm-4 0h2v5H9V5zM5 5h2v5H5V5zm14 14H5v-7h14v7z" Fill="{DynamicResource PrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Str_61}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_106}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 5: Watermark -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6" Padding="12" Click="CardWatermark_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="{DynamicResource PrimaryBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Str_2}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLight}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_110}" FontSize="11" Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 6: PDF to Image -->
